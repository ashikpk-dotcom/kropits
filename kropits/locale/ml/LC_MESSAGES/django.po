msgid "Welcome to KROPITS"
msgstr "KROPITS-ലേക്ക് സ്വാഗതം"

msgid "The future of agritech logistics. Connect directly with farmers, place orders, and get deliveries - all without middlemen."
msgstr "അഗ്രിടെക് ലോജിസ്റ്റിക്സിന്റെ ഭാവി. നേരിട്ട് കർഷകരുമായി ബന്ധപ്പെടുക, ഓർഡറുകൾ സ്ഥാപിക്കുക, ഇടനിലക്കാരില്ലാതെ ഡെലിവറികൾ നേടുക."

msgid "Farmers"
msgstr "കർഷകർ"

msgid "Buyers"
msgstr "വാങ്ങുന്നവർ"

msgid "Delivery Partners"
msgstr "ഡെലിവറി പങ്കാളികൾ"

msgid "List your products, manage inventory, and sell directly to buyers."
msgstr "നിങ്ങളുടെ ഉൽപ്പന്നങ്ങൾ പട്ടികപ്പെടുത്തുക, ഇൻവെന്ററി കൈകാര്യം ചെയ്യുക, നേരിട്ട് വാങ്ങുന്നവർക്ക് വിൽക്കുക."

msgid "Discover nearby farmers, place bulk orders, and get fresh produce delivered."
msgstr "സമീപത്തെ കർഷകരെ കണ്ടെത്തുക, ബൾക്ക് ഓർഡറുകൾ സ്ഥാപിക്കുക, പുതിയ ഉൽപ്പന്നങ്ങൾ ഡെലിവർ ചെയ്യിക്കുക."

msgid "Join our network, pick up orders, and deliver fresh produce to customers."
msgstr "ഞങ്ങളുടെ ശൃംഖലയിൽ ചേരുക, ഓർഡറുകൾ പിക്ക് ചെയ്യുക, ഉപഭോക്താക്കൾക്ക് പുതിയ ഉൽപ്പന്നങ്ങൾ ഡെലിവർ ചെയ്യുക."

